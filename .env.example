FLASK_SECRET_KEY=change-me
# auto | roberta | lexicon
MINDAI_EMOTION_BACKEND=auto

# ---- Phase 2 ----
# Whisper size: tiny | base | small | medium   (use base if transcription is slow)
MINDAI_WHISPER_MODEL=small
# Leave empty to auto-detect the spoken language; set to "en" to force English
MINDAI_WHISPER_LANGUAGE=
# 1 = translate non-English speech to English (needed for the English emotion model)
MINDAI_WHISPER_TRANSLATE=1
# Only needed if Tesseract isn't in the default install folder
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# trocr-base-handwritten (best, ~1.3 GB) or trocr-small-handwritten (~250 MB)
MINDAI_TROCR_MODEL=microsoft/trocr-base-handwritten
# 1 = keep the original recording/photo (encrypted) with each entry
MINDAI_KEEP_MEDIA=1

# ---- Phase 3 ----
# Patterns appear after this many entries
MINDAI_PATTERN_MIN_ENTRIES=8
# An event needs at least this many entries before it can become a pattern
MINDAI_PATTERN_MIN_OCCURRENCES=3
# 1 = also discover recurring personal topics (nouns outside the built-in list)
MINDAI_EXTRACT_TOPICS=1

# ---- Phase 4: AI notes ----
# Local model through Ollama (install from ollama.com, then: ollama pull llama3.2:3b)
MINDAI_OLLAMA_MODEL=llama3.2:3b
# Optional: Gemini, used only after you opt in on the Settings page.
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# gemini-3.8-flash (better) or gemini-3.5-flash-lite (cheaper, faster)
MINDAI_GEMINI_MODEL=gemini-3.8-flash
# Crisis helplines shown instead of AI replies (JSON). Default: Tele-MANAS 14416 and 112.
# MINDAI_HELPLINES=[{"name": "Tele-MANAS", "number": "14416", "note": "free, 24x7"}]
